# Copy to .env.local (gitignored) for local development. Never commit real values.
# QAJitsu reads these through the "env" SecretProvider (REQ-CFG-03). Values are masked everywhere (REQ-CFG-06).

# Jira (REQ-CTX-01, REQ-PUB-01)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=

# Code hosts (REQ-CTX-02)
GITHUB_TOKEN=
GITLAB_BASE_URL=
GITLAB_TOKEN=

# Models (REQ-LLM-01): set only the providers you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
LITELLM_BASE_URL=
LITELLM_KEY=
OLLAMA_BASE_URL=http://localhost:11434
