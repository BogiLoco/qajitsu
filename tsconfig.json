{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["packages/**/src/**/*.ts", "tests/**/*.ts", "examples/**/*.ts", "*.config.ts"],
  "exclude": ["**/node_modules", "**/dist", "**/coverage"]
}
