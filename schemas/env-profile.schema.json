{
  "$id": "https://qajitsu.dev/schemas/env-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "production": {
      "default": false,
      "type": "boolean"
    },
    "health_path": {
      "default": "/health",
      "type": "string",
      "format": "starts_with",
      "pattern": "^\\/.*"
    },
    "version_path": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^\\/.*"
    },
    "version_field": {
      "default": "sha",
      "type": "string"
    },
    "accounts": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9_.-]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1
              },
              "password": {
                "type": "string",
                "pattern": "^secret:\\/\\/[a-z0-9-]+\\/.+$"
              },
              "login_extra": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "lanes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "api",
                    "web",
                    "mobile"
                  ]
                }
              },
              "totp": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^secret:\\/\\/[a-z0-9-]+\\/.+$"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "seed": {
                        "type": "string",
                        "pattern": "^secret:\\/\\/[a-z0-9-]+\\/.+$"
                      },
                      "digits": {
                        "default": 6,
                        "type": "integer",
                        "minimum": 6,
                        "maximum": 8
                      },
                      "period": {
                        "default": 30,
                        "type": "integer",
                        "minimum": 15,
                        "maximum": 120
                      },
                      "algorithm": {
                        "default": "sha1",
                        "type": "string",
                        "enum": [
                          "sha1",
                          "sha256",
                          "sha512"
                        ]
                      }
                    },
                    "required": [
                      "seed"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "shared": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "username",
              "password"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "pool": {
                "minItems": 1,
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "username": {
                      "type": "string",
                      "minLength": 1
                    },
                    "password": {
                      "type": "string",
                      "pattern": "^secret:\\/\\/[a-z0-9-]+\\/.+$"
                    },
                    "login_extra": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    },
                    "lanes": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "api",
                          "web",
                          "mobile"
                        ]
                      }
                    },
                    "totp": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^secret:\\/\\/[a-z0-9-]+\\/.+$"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "seed": {
                              "type": "string",
                              "pattern": "^secret:\\/\\/[a-z0-9-]+\\/.+$"
                            },
                            "digits": {
                              "default": 6,
                              "type": "integer",
                              "minimum": 6,
                              "maximum": 8
                            },
                            "period": {
                              "default": 30,
                              "type": "integer",
                              "minimum": 15,
                              "maximum": 120
                            },
                            "algorithm": {
                              "default": "sha1",
                              "type": "string",
                              "enum": [
                                "sha1",
                                "sha256",
                                "sha512"
                              ]
                            }
                          },
                          "required": [
                            "seed"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "username",
                    "password"
                  ],
                  "additionalProperties": false
                }
              },
              "shared": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "pool"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "login": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "default": "POST",
              "type": "string",
              "enum": [
                "POST",
                "PUT"
              ]
            },
            "path": {
              "type": "string",
              "format": "starts_with",
              "pattern": "^\\/.*"
            },
            "body": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "token_path": {
              "type": "string",
              "minLength": 1
            },
            "header": {
              "default": "authorization",
              "type": "string"
            },
            "scheme": {
              "default": "Bearer",
              "type": "string"
            }
          },
          "required": [
            "path",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "script": {
              "type": "string",
              "pattern": "^auth\\/[\\w.-]+(\\/[\\w.-]+)*$"
            },
            "timeout_s": {
              "default": 30,
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            }
          },
          "required": [
            "script"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "browser": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "format": "starts_with",
                  "pattern": "^\\/.*"
                },
                "steps": {
                  "minItems": 1,
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "fill": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          }
                        },
                        "required": [
                          "fill",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "click": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          }
                        },
                        "required": [
                          "click"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "press": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          },
                          "key": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40
                          }
                        },
                        "required": [
                          "press",
                          "key"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "wait_for": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          }
                        },
                        "required": [
                          "wait_for"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "done": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "format": "starts_with",
                      "pattern": "^\\/.*"
                    },
                    "selector": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "additionalProperties": false
                },
                "allow": {
                  "default": [],
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "timeout_s": {
                  "default": 60,
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 300
                },
                "reuse": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "required": [
                "start",
                "steps",
                "done"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "browser"
          ],
          "additionalProperties": false
        }
      ]
    },
    "web_session": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "storage": {
              "type": "string",
              "enum": [
                "sessionStorage",
                "localStorage"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "storage",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "storage": {
              "type": "string",
              "const": "cookies"
            }
          },
          "required": [
            "storage"
          ],
          "additionalProperties": false
        }
      ]
    },
    "http_auth": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "pattern": "^secret:\\/\\/[a-z0-9-]+\\/.+$"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "additionalProperties": false
    },
    "test_headers": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]{1,60}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "flags": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    }
  },
  "required": [
    "base_url"
  ],
  "additionalProperties": false
}
