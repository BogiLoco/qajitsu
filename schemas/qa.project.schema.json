                    "file": {
                      "type": "string",
                      "pattern": "^(?!\\/)(?!.*\\.\\.)[\\w./*-]+$"
                    }
                  },
                  "required": [
                    "source",
                    "repo",
                    "artifact",
                    "file"
                  ],
                  "additionalProperties": false
