                  "minLength": 1
                }
              },
              "cwd": {
                "type": "string",
                "pattern": "^(?!\\/)(?!.*\\.\\.)[\\w./-]+$"
              },
              "env": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string"
                        },
                        "overridable": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "template": {
                          "type": "string"
                        },
                        "overridable": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "template"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "secret": {
                          "type": "string",
                          "pattern": "^secret:\\/\\/[a-z0-9-]+\\/.+$"
                        }
                      },
                      "required": [
                        "secret"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "health": {
                "type": "object",
                "properties": {
                  "http": {
                    "type": "string",
                    "format": "starts_with",
                    "pattern": "^\\/.*"
                  },
                  "port": {
                    "type": "boolean",
                    "const": true
                  },
                  "log": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeout_s": {
                    "default": 60,
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 900
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "command"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "stub"
              },
              "engine": {
                "type": "string",
                "enum": [
                  "wiremock",
                  "mockoon"
                ]
              },
              "mappings": {
                "type": "string",
                "pattern": "^(?!\\/)(?!.*\\.\\.)[\\w./-]+$"
              },
              "env": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string"
                        },
                        "overridable": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "template": {
                          "type": "string"
                        },
                        "overridable": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "template"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "secret": {
                          "type": "string",
                          "pattern": "^secret:\\/\\/[a-z0-9-]+\\/.+$"
                        }
                      },
                      "required": [
                        "secret"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "health": {
                "type": "object",
                "properties": {
                  "http": {
                    "type": "string",
                    "format": "starts_with",
                    "pattern": "^\\/.*"
                  },
                  "port": {
                    "type": "boolean",
                    "const": true
                  },
                  "log": {
                    "type": "string",
                    "minLength": 1
