              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "env": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
