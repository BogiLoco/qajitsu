                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "secret": {
                          "type": "string",
                          "pattern": "^secret:\\/\\/[a-z0-9-]+\\/.+$"
                        }
                      },
                      "required": [
                        "secret"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "health": {
                "type": "object",
                "properties": {
                  "http": {
                    "type": "string",
                    "format": "starts_with",
                    "pattern": "^\\/.*"
                  },
                  "port": {
                    "type": "boolean",
