            "intent_args": {
              "type": "string",
              "maxLength": 500,
              "pattern": "^[\\w\\s.:/{}=,-]*$"
            },
            "emulator": {
              "type": "object",
              "properties": {
                "avd": {
                  "default": "qajitsu",
                  "type": "string",
                  "pattern": "^[\\w.-]+$"
