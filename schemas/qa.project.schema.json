                        }
                      },
                      "required": [
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "template": {
                          "type": "string"
                        },
                        "overridable": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "template"
