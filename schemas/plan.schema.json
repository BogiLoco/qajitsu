{
  "$id": "https://qajitsu.dev/schemas/plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "ticket": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "summary": {
      "default": "",
      "type": "string"
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC-\\d{2,4}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "type": {
            "type": "string",
            "enum": [
              "api",
              "web",
              "mobile"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reproduces": {
            "default": false,
            "type": "boolean"
          },
          "source": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "ac"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^AC[1-9]\\d*$"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "quote"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "diff"
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lines": {
                      "type": "string",
                      "pattern": "^\\d+(?:-\\d+)?$"
                    }
                  },
                  "required": [
                    "kind",
                    "repo",
                    "file"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "comment"
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "repo",
                    "index"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "doc"
                    },
                    "chunk": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{16}-\\d+$"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 12
                    },
                    "path": {
                      "type": "string"
                    },
                    "section": {
                      "type": "string"
                    },
                    "modified": {
                      "type": "string"
                    },
                    "outdated": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "chunk",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "observation"
                    },
                    "session": {
                      "type": "string",
                      "pattern": "^S\\d{2,3}$"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^O\\d{1,3}$"
                    }
                  },
                  "required": [
                    "kind",
                    "session",
                    "id"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "preconditions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9_.-]+$"
            }
          },
          "locales": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Z][A-Za-z]{1,3})?$"
            }
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^S\\d{1,3}$"
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "expect": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    },
                    "fields": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "texts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "elements": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^(testid|role|label|text|css):[^.]+$"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "visible": {
                            "type": "boolean"
                          },
                          "enabled": {
                            "type": "boolean"
                          },
                          "checked": {
                            "type": "boolean"
                          },
                          "text": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "message": {
                      "type": "object",
                      "properties": {
                        "to": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "subject": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "body": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "within_s": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3600
                        }
                      },
                      "additionalProperties": false
                    },
                    "visual": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
                        },
                        "threshold": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "mask": {
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          }
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    "by_locale": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[a-z]{2,3}(-[A-Z][A-Za-z]{1,3})?$"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "fields": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          },
                          "texts": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "elements": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "object",
                              "properties": {
                                "visible": {
                                  "type": "boolean"
                                },
                                "enabled": {
                                  "type": "boolean"
                                },
                                "checked": {
                                  "type": "boolean"
                                },
                                "text": {
                                  "type": "string"
                                },
                                "value": {
                                  "type": "string"
                                }
                              },
                              "additionalProperties": false
                            }
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "description"
                  ],
                  "additionalProperties": false
                },
                "manual": {
                  "type": "boolean"
                },
                "instructions": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 1000
                }
              },
              "required": [
                "id",
                "action",
                "expect"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "request",
                "response",
                "screenshot",
                "video",
                "trace",
                "log",
                "har"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "priority",
          "source",
          "steps",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "open_questions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[1-9]\\d*$"
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "question"
        ],
        "additionalProperties": false
      }
    },
    "out_of_scope": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "existing_coverage": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "covers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "repo",
          "file",
          "title",
          "covers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "ticket",
    "version",
    "cases"
  ],
  "additionalProperties": false
}
