{
  "$id": "https://qajitsu.dev/schemas/plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "ticket": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "summary": {
      "default": "",
      "type": "string"
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC-\\d{2,4}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "type": {
            "type": "string",
            "enum": [
              "api",
              "web",
              "mobile"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reproduces": {
            "default": false,
            "type": "boolean"
          },
          "source": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "ac"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^AC[1-9]\\d*$"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "quote"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "diff"
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lines": {
                      "type": "string",
                      "pattern": "^\\d+(?:-\\d+)?$"
                    }
                  },
                  "required": [
                    "kind",
                    "repo",
                    "file"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "comment"
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "repo",
                    "index"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "doc"
                    },
                    "chunk": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{16}-\\d+$"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 12
                    },
                    "path": {
                      "type": "string"
                    },
                    "section": {
                      "type": "string"
                    },
                    "modified": {
                      "type": "string"
                    },
                    "outdated": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "chunk",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "imported"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^(xray|zephyr|testrail|file):[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "map"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^(page|api):\\S.{0,300}$"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "observation"
                    },
                    "session": {
                      "type": "string",
                      "pattern": "^S\\d{2,3}$"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^O\\d{1,3}$"
                    }
                  },
                  "required": [
                    "kind",
                    "session",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "explore"
                    },
                    "session": {
                      "type": "string",
                      "pattern": "^S\\d{2,3}$"
                    },
                    "item": {
                      "type": "string",
                      "pattern": "^[OFC][1-9]\\d{0,2}$"
                    }
                  },
                  "required": [
                    "kind",
                    "session",
                    "item"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "preconditions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9_.-]+$"
            }
          },
          "locales": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Z][A-Za-z]{1,3})?$"
            }
          },
          "browser": {
            "type": "object",
            "properties": {
              "clock": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "service_workers": {
                "type": "boolean"
              },
              "permissions": {
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "geolocation",
                    "notifications",
                    "clipboard-read",
                    "clipboard-write",
                    "camera",
                    "microphone"
                  ]
                }
              },
              "geolocation": {
                "type": "object",
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "accuracy": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  }
                },
                "required": [
                  "latitude",
                  "longitude"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "files": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,40}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "fixture": {
                      "type": "string",
                      "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.(\\/|$))[A-Za-z0-9_./-]{1,200}$"
                    }
                  },
                  "required": [
                    "fixture"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.() -]{1,100}$"
                    },
                    "type": {
                      "type": "string",
                      "pattern": "^[a-z]+\\/[a-z0-9.+-]+$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 50000000
                    }
                  },
                  "required": [
                    "name",
                    "type",
                    "bytes"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^S\\d{1,3}$"
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "expect": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    },
                    "fields": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "texts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "elements": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "visible": {
                            "type": "boolean"
                          },
                          "enabled": {
                            "type": "boolean"
                          },
                          "checked": {
                            "type": "boolean"
                          },
                          "text": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          },
                          "in_viewport": {
                            "type": "boolean"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "dialog": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "alert",
                            "confirm",
                            "prompt",
                            "beforeunload"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        }
                      },
                      "additionalProperties": false
                    },
                    "download": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        },
                        "type": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "min_bytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "max_bytes": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "texts": {
                          "maxItems": 50,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "rows": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "fields": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        }
                      },
                      "additionalProperties": false
                    },
                    "websocket": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "received": {
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                          }
                        },
                        "sent": {
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "manifest": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "short_name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "start_url": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "display": {
                          "type": "string",
                          "enum": [
                            "fullscreen",
                            "standalone",
                            "minimal-ui",
                            "browser"
                          ]
                        },
                        "icons": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "controlled": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    },
                    "state": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_$][\\w$]*(\\.[\\w$]+|\\[\\d+\\])*$"
                      },
                      "additionalProperties": {}
                    },
                    "message": {
                      "type": "object",
                      "properties": {
                        "to": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "subject": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "body": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "within_s": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3600
                        },
                        "code": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "additionalProperties": false
                    },
                    "visual": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
                        },
                        "threshold": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "mask": {
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          }
                        },
                        "element": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    "by_locale": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[a-z]{2,3}(-[A-Z][A-Za-z]{1,3})?$"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "fields": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          },
                          "texts": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "elements": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "object",
                              "properties": {
                                "visible": {
                                  "type": "boolean"
                                },
                                "enabled": {
                                  "type": "boolean"
                                },
                                "checked": {
                                  "type": "boolean"
                                },
                                "text": {
                                  "type": "string"
                                },
                                "value": {
                                  "type": "string"
                                },
                                "in_viewport": {
                                  "type": "boolean"
                                }
                              },
                              "additionalProperties": false
                            }
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "description"
                  ],
                  "additionalProperties": false
                },
                "manual": {
                  "type": "boolean"
                },
                "instructions": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 1000
                },
                "dialog": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "accept",
                        "dismiss"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "action"
                  ],
                  "additionalProperties": false
                },
                "scroll_limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200
                }
              },
              "required": [
                "id",
                "action",
                "expect"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "request",
                "response",
                "screenshot",
                "video",
                "trace",
                "log",
                "har"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "priority",
          "source",
          "steps",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "open_questions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[1-9]\\d*$"
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "question"
        ],
        "additionalProperties": false
      }
    },
    "out_of_scope": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "existing_coverage": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "covers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "repo",
          "file",
          "title",
          "covers"
        ],
        "additionalProperties": false
      }
    },
    "depth": {
      "type": "string",
      "enum": [
        "smoke",
        "standard",
        "full"
      ]
    },
    "selection": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "included": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "case",
          "title",
          "priority",
          "included",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "ticket",
    "version",
    "cases"
  ],
  "additionalProperties": false
}
