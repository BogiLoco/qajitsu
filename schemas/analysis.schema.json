{
  "$id": "https://qajitsu.dev/schemas/analysis.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "change_type": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "api",
          "web",
          "mobile"
        ]
      }
    },
    "endpoints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "ac"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^AC[1-9]\\d*$"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "quote"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "diff"
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lines": {
                      "type": "string",
                      "pattern": "^\\d+(?:-\\d+)?$"
                    }
                  },
                  "required": [
                    "kind",
                    "repo",
                    "file"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "comment"
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "repo",
                    "index"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "observation"
                    },
                    "session": {
                      "type": "string",
                      "pattern": "^S\\d{2,3}$"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^O\\d{1,3}$"
                    }
                  },
                  "required": [
                    "kind",
                    "session",
                    "id"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "path",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "screens": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "ac"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^AC[1-9]\\d*$"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "quote"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "diff"
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lines": {
                      "type": "string",
                      "pattern": "^\\d+(?:-\\d+)?$"
                    }
                  },
                  "required": [
                    "kind",
                    "repo",
                    "file"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "comment"
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "repo",
                    "index"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "observation"
                    },
                    "session": {
                      "type": "string",
                      "pattern": "^S\\d{2,3}$"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^O\\d{1,3}$"
                    }
                  },
                  "required": [
                    "kind",
                    "session",
                    "id"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "name",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "risks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "ac"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^AC[1-9]\\d*$"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "quote"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "diff"
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lines": {
                      "type": "string",
                      "pattern": "^\\d+(?:-\\d+)?$"
                    }
                  },
                  "required": [
                    "kind",
                    "repo",
                    "file"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "comment"
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "repo",
                    "index"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "observation"
                    },
                    "session": {
                      "type": "string",
                      "pattern": "^S\\d{2,3}$"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^O\\d{1,3}$"
                    }
                  },
                  "required": [
                    "kind",
                    "session",
                    "id"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "description",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "open_questions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[1-9]\\d*$"
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "question"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "change_type",
    "confidence"
  ],
  "additionalProperties": false
}
