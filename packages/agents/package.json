{
  "name": "@qajitsu/agents",
  "version": "0.1.0",
  "description": "QAJitsu agents: provider-agnostic agent loop and role definitions (analyst, planner, author, healer, auditor).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/agents"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/agents#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@qajitsu/core": "workspace:*",
    "@qajitsu/guard": "workspace:*",
    "@qajitsu/models": "workspace:*",
    "@qajitsu/steps": "workspace:*",
    "@qajitsu/verifier": "workspace:*",
    "@ai-sdk/mcp": "catalog:",
    "ai": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
