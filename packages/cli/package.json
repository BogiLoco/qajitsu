{
  "name": "@qajitsu/cli",
  "version": "0.0.0",
  "description": "QAJitsu command line: qajitsu (alias qj).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "qajitsu": "./dist/bin.js",
    "qj": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "plugins.json",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@qajitsu/adapter-codehost-local": "workspace:*",
    "@qajitsu/adapter-env-remote": "workspace:*",
    "@qajitsu/adapter-evidence-local": "workspace:*",
    "@qajitsu/adapter-files": "workspace:*",
    "@qajitsu/adapter-secrets-env": "workspace:*",
    "@qajitsu/agents": "workspace:*",
    "@qajitsu/core": "workspace:*",
    "@qajitsu/models": "workspace:*",
    "@qajitsu/report": "workspace:*",
    "@qajitsu/steps": "workspace:*",
    "@qajitsu/toolchain": "workspace:*",
    "@qajitsu/verifier": "workspace:*",
    "commander": "catalog:",
    "pino": "^10.4.0",
    "playwright-core": "1.63.0",
    "unpdf": "1.8.1",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@qajitsu/adapter-codehost-github": "workspace:*",
    "@qajitsu/adapter-codehost-gitlab": "workspace:*",
    "@qajitsu/adapter-env-compose": "workspace:*",
    "@qajitsu/adapter-evidence-s3": "workspace:*",
    "@qajitsu/adapter-knowledge-chroma": "workspace:*",
    "@qajitsu/adapter-knowledge-confluence": "workspace:*",
    "@qajitsu/adapter-knowledge-lancedb": "workspace:*",
    "@qajitsu/adapter-messages-webhooksite": "workspace:*",
    "@qajitsu/adapter-publish-jira": "workspace:*",
    "@qajitsu/adapter-runner-api": "workspace:*",
    "@qajitsu/adapter-runner-mobile": "workspace:*",
    "@qajitsu/adapter-runner-web": "workspace:*",
    "@qajitsu/adapter-secrets-cli": "workspace:*",
    "@qajitsu/adapter-secrets-doppler": "workspace:*",
    "@qajitsu/adapter-secrets-vault": "workspace:*",
    "@qajitsu/adapter-testcases": "workspace:*",
    "@qajitsu/adapter-ticket-jira": "workspace:*",
    "@types/pngjs": "^6.0.5",
    "pngjs": "7.0.0"
  }
}
