{
  "name": "@qajitsu/adapter-runner-api",
  "version": "0.1.0",
  "description": "QAJitsu API Runner on Playwright APIRequestContext with OpenAPI validation.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/adapters/runner-api"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/adapters/runner-api#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "playwright-core": "1.63.0",
    "yaml": "catalog:",
    "zod": "catalog:",
    "pngjs": "7.0.0"
  },
  "peerDependencies": {
    "@qajitsu/core": "workspace:^",
    "@qajitsu/steps": "workspace:^"
  },
  "devDependencies": {
    "@qajitsu/adapter-evidence-local": "workspace:*",
    "@qajitsu/core": "workspace:*",
    "@qajitsu/steps": "workspace:*",
    "@types/pngjs": "^6.0.5"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "runner",
        "test data"
      ],
      "core_api": "^1.0.0",
      "secrets": [
        "account credentials"
      ],
      "hosts": [
        "config"
      ],
      "permissions": [
        "network",
        "exec",
        "filesystem",
        "environment"
      ]
    }
  }
}
