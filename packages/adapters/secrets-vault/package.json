{
  "name": "@qajitsu/adapter-secrets-vault",
  "version": "0.0.0",
  "description": "QAJitsu SecretProvider 'vault': HashiCorp Vault KV v2 over HTTP.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@qajitsu/core": "workspace:^"
  },
  "devDependencies": {
    "@qajitsu/core": "workspace:*"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "secret provider"
      ],
      "core_api": "^1.0.0",
      "secrets": [
        "Vault token"
      ],
      "hosts": [
        "config"
      ],
      "permissions": [
        "network"
      ]
    }
  }
}
