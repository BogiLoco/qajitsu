{
  "name": "@qajitsu/adapter-runner-web",
  "version": "0.0.0",
  "description": "QAJitsu web UI runner: the trusted parent drives Playwright with screenshots, video, trace, HAR and console log.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@qajitsu/adapter-runner-api": "workspace:*",
    "@qajitsu/steps": "workspace:*",
    "@qajitsu/toolchain": "workspace:*",
    "axe-core": "catalog:",
    "pixelmatch": "8.0.0",
    "playwright-core": "^1.63.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@qajitsu/adapter-evidence-local": "workspace:*",
    "@qajitsu/core": "workspace:*",
    "@qajitsu/verifier": "workspace:*",
    "@types/pngjs": "^6.0.5"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "runner"
      ],
      "core_api": "^1.0.0",
      "secrets": [
        "account credentials",
        "TOTP seeds"
      ],
      "hosts": [
        "config"
      ],
      "permissions": [
        "network",
        "exec",
        "filesystem"
      ]
    }
  }
}
