{
  "name": "@qajitsu/adapter-env-remote",
  "version": "0.0.0",
  "description": "QAJitsu EnvProvider for an existing environment given by profile or URL.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/adapters/env-remote"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/adapters/env-remote#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@qajitsu/core": "workspace:*",
    "zod": "catalog:"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "environment provider"
      ],
      "core_api": "^1.0.0",
      "secrets": [
        "account credentials",
        "TOTP seeds"
      ],
      "hosts": [
        "config"
      ],
      "permissions": [
        "network",
        "exec",
        "environment"
      ]
    }
  }
}
