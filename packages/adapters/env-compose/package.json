{
  "name": "@qajitsu/adapter-env-compose",
  "version": "0.1.0",
  "description": "QAJitsu --build environment: Docker Compose overlay with labels and dynamic ports, managed processes, stubs, health checks and seeding.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/adapters/env-compose"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/adapters/env-compose#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "@qajitsu/core": "workspace:^"
  },
  "devDependencies": {
    "@qajitsu/core": "workspace:*"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "environment provider"
      ],
      "core_api": "^1.0.0",
      "secrets": [
        "service variables"
      ],
      "hosts": [
        "localhost"
      ],
      "permissions": [
        "network",
        "exec",
        "filesystem",
        "environment"
      ]
    }
  }
}
