{
  "name": "@qajitsu/adapter-files",
  "version": "0.1.0",
  "description": "QAJitsu local-file adapters of the core installation: tickets, workflow, publisher, bug tracker, resolved bugs and manual cases from files (demo, offline runs, tests).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/adapters/files"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/adapters/files#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@qajitsu/core": "workspace:*",
    "zod": "catalog:"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "ticket source",
        "ticket workflow",
        "publisher",
        "bug tracker",
        "document source",
        "test-case source"
      ],
      "core_api": "^1.0.0",
      "secrets": [],
      "hosts": [],
      "permissions": [
        "filesystem"
      ]
    }
  }
}
