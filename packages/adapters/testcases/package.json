{
  "name": "@qajitsu/adapter-testcases",
  "version": "0.0.0",
  "description": "QAJitsu TestCaseSource adapters: manual test cases from Xray Cloud, Zephyr Scale, TestRail and CSV/Excel files.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/adapters/testcases"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/adapters/testcases#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@qajitsu/core": "workspace:^"
  },
  "devDependencies": {
    "@qajitsu/adapter-files": "workspace:*",
    "@qajitsu/core": "workspace:*",
    "@qajitsu/report": "workspace:*"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "test-case source"
      ],
      "core_api": "^1.0.0",
      "secrets": [
        "client secret",
        "API token"
      ],
      "hosts": [
        "xray.cloud.getxray.app",
        "api.zephyrscale.smartbear.com",
        "config"
      ],
      "permissions": [
        "network",
        "filesystem"
      ]
    }
  }
}
