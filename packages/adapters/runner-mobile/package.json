{
  "name": "@qajitsu/adapter-runner-mobile",
  "version": "0.0.0",
  "description": "QAJitsu mobile Runner on WebdriverIO and Appium (Android UiAutomator2, iOS XCUITest).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "webdriverio": "9.32.0"
  },
  "peerDependencies": {
    "@qajitsu/adapter-runner-api": "workspace:^",
    "@qajitsu/core": "workspace:^",
    "@qajitsu/steps": "workspace:^",
    "@qajitsu/toolchain": "workspace:^"
  },
  "devDependencies": {
    "@qajitsu/adapter-runner-api": "workspace:*",
    "@qajitsu/core": "workspace:*",
    "@qajitsu/steps": "workspace:*",
    "@qajitsu/toolchain": "workspace:*"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "runner",
        "device provider"
      ],
      "core_api": "^1.0.0",
      "secrets": [
        "account credentials",
        "device farm access key"
      ],
      "hosts": [
        "localhost",
        "config"
      ],
      "permissions": [
        "network",
        "exec",
        "filesystem",
        "environment"
      ]
    }
  }
}
