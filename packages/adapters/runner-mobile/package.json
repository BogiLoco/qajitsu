{
  "name": "@qajitsu/adapter-runner-mobile",
  "version": "0.1.0",
  "description": "QAJitsu mobile Runner on WebdriverIO and Appium (Android UiAutomator2, iOS XCUITest).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/adapters/runner-mobile"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/adapters/runner-mobile#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "webdriverio": "9.32.0"
  },
  "peerDependencies": {
    "@qajitsu/adapter-runner-api": "workspace:^",
    "@qajitsu/core": "workspace:^",
    "@qajitsu/steps": "workspace:^",
    "@qajitsu/toolchain": "workspace:^"
  },
  "devDependencies": {
    "@qajitsu/adapter-runner-api": "workspace:*",
    "@qajitsu/core": "workspace:*",
    "@qajitsu/steps": "workspace:*",
    "@qajitsu/toolchain": "workspace:*"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "runner",
        "device provider"
      ],
      "core_api": "^1.0.0",
      "secrets": [
        "account credentials",
        "device farm access key"
      ],
      "hosts": [
        "localhost",
        "config"
      ],
      "permissions": [
        "network",
        "exec",
        "filesystem",
        "environment"
      ]
    }
  }
}
