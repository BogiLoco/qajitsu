{
  "name": "@qajitsu/adapter-knowledge-lancedb",
  "version": "0.1.0",
  "description": "QAJitsu VectorStore on LanceDB, embedded in the process, one database per project (ADR-0007).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/adapters/knowledge-lancedb"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/adapters/knowledge-lancedb#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@lancedb/lancedb": "0.39.0",
    "apache-arrow": "18.1.0"
  },
  "peerDependencies": {
    "@qajitsu/core": "workspace:^"
  },
  "devDependencies": {
    "@qajitsu/core": "workspace:*"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "knowledge store"
      ],
      "core_api": "^1.0.0",
      "secrets": [],
      "hosts": [],
      "permissions": [
        "filesystem"
      ],
      "omit_optional": [
        "@huggingface/transformers",
        "openai"
      ]
    }
  }
}
