{
  "name": "@qajitsu/adapter-secrets-cli",
  "version": "0.0.0",
  "description": "QAJitsu SecretProviders through official CLIs: 1Password (op), AWS Secrets Manager (aws), GCP Secret Manager (gcloud).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@qajitsu/core": "workspace:^"
  },
  "devDependencies": {
    "@qajitsu/core": "workspace:*"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "secret provider"
      ],
      "core_api": "^1.0.0",
      "secrets": [],
      "hosts": [],
      "permissions": [
        "exec"
      ]
    }
  }
}
