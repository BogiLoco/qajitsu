{
  "name": "@qajitsu/adapter-knowledge-confluence",
  "version": "0.0.0",
  "description": "QAJitsu DocumentSource for Confluence spaces and pages (Cloud and Data Center), synced by page version.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@qajitsu/core": "workspace:^"
  },
  "devDependencies": {
    "@qajitsu/core": "workspace:*"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "document source"
      ],
      "core_api": "^1.0.0",
      "secrets": [
        "API token"
      ],
      "hosts": [
        "*.atlassian.net",
        "config"
      ],
      "permissions": [
        "network"
      ]
    }
  }
}
