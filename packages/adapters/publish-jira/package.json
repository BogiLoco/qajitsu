{
  "name": "@qajitsu/adapter-publish-jira",
  "version": "0.1.0",
  "description": "QAJitsu Publisher: Jira comment (ADF on Cloud, wiki markup on Data Center) with attachments.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/adapters/publish-jira"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/adapters/publish-jira#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@qajitsu/core": "workspace:^"
  },
  "devDependencies": {
    "@qajitsu/adapter-files": "workspace:*",
    "@qajitsu/core": "workspace:*"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "publisher",
        "ticket workflow",
        "bug tracker"
      ],
      "core_api": "^1.0.0",
      "secrets": [
        "API token"
      ],
      "hosts": [
        "*.atlassian.net",
        "config"
      ],
      "permissions": [
        "network",
        "filesystem"
      ]
    }
  }
}
