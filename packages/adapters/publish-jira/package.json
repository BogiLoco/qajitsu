{
  "name": "@qajitsu/adapter-publish-jira",
  "version": "0.0.0",
  "description": "QAJitsu Publisher: Jira comment (ADF on Cloud, wiki markup on Data Center) with attachments.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@qajitsu/core": "workspace:*",
    "zod": "catalog:"
  },
  "qajitsu": {
    "plugin": {
      "types": [
        "publisher",
        "ticket workflow",
        "bug tracker"
      ],
      "core_api": "^1.0.0",
      "secrets": [
        "API token"
      ],
      "hosts": [
        "*.atlassian.net",
        "config"
      ],
      "permissions": [
        "network"
      ]
    }
  }
}
