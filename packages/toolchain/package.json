{
  "name": "@qajitsu/toolchain",
  "version": "0.0.0",
  "description": "QAJitsu toolchain setup: pinned versions, compatibility checks, installs into ~/.qajitsu/toolchain and the environment for the tools QAJitsu starts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/toolchain"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/toolchain#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@qajitsu/core": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
