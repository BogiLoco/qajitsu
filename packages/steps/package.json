{
  "name": "@qajitsu/steps",
  "version": "0.0.0",
  "description": "QAJitsu steps library used by generated tests: step(), verify(), secret masking and evidence recording.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/steps"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/steps#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@qajitsu/core": "workspace:*",
    "@xmldom/xmldom": "0.9.12",
    "xpath": "0.0.36"
  }
}
