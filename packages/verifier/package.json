{
  "name": "@qajitsu/verifier",
  "version": "0.0.0",
  "description": "QAJitsu verifier: status computation, publish gates, assertion lock and plan coverage checks.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/verifier"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/verifier#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@qajitsu/core": "workspace:*",
    "@qajitsu/steps": "workspace:*",
    "@xmldom/xmldom": "0.9.12",
    "graphql": "16.11.0",
    "typescript": "catalog:",
    "xmllint-wasm": "5.3.0"
  }
}
