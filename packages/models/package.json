{
  "name": "@qajitsu/models",
  "version": "0.0.0",
  "description": "QAJitsu model layer: provider-agnostic access to LLMs (cloud, LiteLLM, Ollama) with a model per agent role.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BogiLoco/qajitsu.git",
    "directory": "packages/models"
  },
  "homepage": "https://github.com/BogiLoco/qajitsu/tree/main/packages/models#readme",
  "bugs": {
    "url": "https://github.com/BogiLoco/qajitsu/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "qajitsu-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/openai-compatible": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@qajitsu/core": "workspace:*",
    "ai": "catalog:",
    "ai-sdk-ollama": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  }
}
