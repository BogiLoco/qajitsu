      "type": "web",
      "priority": "high",
      "source": [{ "kind": "ac", "id": "AC1" }],
      "data": { "user": "user:standard" },
      "steps": [
        {
          "id": "S1",
          "action": "Open the checkout page",
          "expect": {
            "description": "Button disabled",
            "elements": { "testid:place-order": { "enabled": false } }
          }
        },
        {
          "id": "S2",
          "action": "Accept the terms",
          "expect": {
            "description": "Button enabled",
            "elements": { "testid:place-order": { "enabled": true } }
          }
        }
      ],
      "evidence": ["screenshot"]
    },
    {
